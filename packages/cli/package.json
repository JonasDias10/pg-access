{
  "name": "@pg-access/cli",
  "version": "0.1.0",
  "description": "Command-line interface for pg-access: generates PostgreSQL RLS migrations from a pgaccess.config file, and checks a live database for drift.",
  "license": "MIT",
  "author": "pg-access contributors",
  "homepage": "https://github.com/JonasDias10/pg-access/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonasDias10/pg-access.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/JonasDias10/pg-access/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "rls",
    "row-level-security",
    "authorization",
    "policy",
    "migration",
    "supabase",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pg-access": "./bin/pg-access.js"
  },
  "files": [
    "build",
    "bin",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "clean": "rm -rf build *.tsbuildinfo",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@pg-access/core": "workspace:*",
    "@pg-access/postgres": "workspace:*",
    "jiti": "2.7.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
