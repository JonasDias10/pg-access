{
  "name": "@pg-access/core",
  "version": "0.1.0",
  "description": "Type-safe DSL and AST for declaring PostgreSQL authorization policies. Framework-agnostic, produces no SQL.",
  "license": "MIT",
  "author": "pg-access contributors",
  "homepage": "https://github.com/JonasDias10/pg-access/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonasDias10/pg-access.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/JonasDias10/pg-access/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "rls",
    "row-level-security",
    "authorization",
    "policy",
    "supabase",
    "dsl"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "build",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "clean": "rm -rf build *.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
