{
  "name": "@pg-access/testing",
  "version": "0.1.1",
  "description": "Helpers for testing PostgreSQL Row-Level Security policies against a real database: run a query as a given role/JWT claims, inside an auto-rolled-back transaction.",
  "license": "MIT",
  "author": "pg-access contributors",
  "homepage": "https://github.com/JonasDias10/pg-access/tree/main/packages/testing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonasDias10/pg-access.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/JonasDias10/pg-access/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "rls",
    "row-level-security",
    "authorization",
    "policy",
    "supabase",
    "testing",
    "vitest"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "build",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "clean": "rm -rf build *.tsbuildinfo",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@pg-access/postgres": "workspace:*"
  },
  "peerDependencies": {
    "pg": ">=8"
  },
  "devDependencies": {
    "@pg-access/core": "workspace:*",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
