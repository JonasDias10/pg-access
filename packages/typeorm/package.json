{
  "name": "@pg-access/typeorm",
  "version": "0.0.0",
  "description": "Writes pg-access RLS policies as TypeORM migration classes, with an up() and a down() that restores the previous policies.",
  "license": "MIT",
  "author": "pg-access contributors",
  "homepage": "https://github.com/JonasDias10/pg-access/tree/main/packages/typeorm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonasDias10/pg-access.git",
    "directory": "packages/typeorm"
  },
  "bugs": {
    "url": "https://github.com/JonasDias10/pg-access/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "rls",
    "row-level-security",
    "authorization",
    "policy",
    "migration",
    "typeorm"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "build",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "clean": "rm -rf build *.tsbuildinfo",
    "test": "vitest run test/unit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@pg-access/core": "workspace:*",
    "@pg-access/postgres": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
