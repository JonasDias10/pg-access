{
  "name": "@pg-access/example-supabase",
  "private": true,
  "version": "0.0.0",
  "description": "pg-access driving a real Supabase project: pgaccess.config.ts -> pg-access generate -> migration -> a Fastify API with live RLS enforcement.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate": "pg-access generate",
    "generate:db": "node --env-file=.env node_modules/.bin/pg-access generate",
    "check": "node --env-file=.env node_modules/.bin/pg-access check",
    "baseline": "node --env-file=.env node_modules/.bin/pg-access baseline",
    "dev": "tsx --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:integration": "vitest run test/integration --no-file-parallelism"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@pg-access/core": "workspace:*",
    "@supabase/supabase-js": "^2.112.3",
    "fastify": "5.12.1",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@pg-access/cli": "workspace:*",
    "@pg-access/postgres": "workspace:*",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
